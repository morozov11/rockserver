# Optional local Yandex AI Studio intent parser. Leave secret values empty.
YANDEX_AI_API_KEY=
YANDEX_FOLDER_ID=

# Required application API credential. Generate a unique random value of at least 32 characters.
# ROCKSERVER_API_BEARER_TOKEN=

# Optional local CPU semantic search. Build with `--features onnx-local` and
# keep the downloaded E5 ONNX graph, tokenizer and ONNX Runtime DLL outside Git.
# ROCKSERVER_SEMANTIC_PROVIDER=onnx-e5-local
# ROCKSERVER_ONNX_MODEL_PATH=C:\\models\\multilingual-e5-small\\model.onnx
# ROCKSERVER_ONNX_TOKENIZER_PATH=C:\\models\\multilingual-e5-small\\tokenizer.json
# ORT_DYLIB_PATH=C:\\onnxruntime\\onnxruntime.dll
# ROCKSERVER_ONNX_INTRA_THREADS=2
# Optional safety switch for confidence-gated E5 language hard filters. Defaults to on whenever
# the local E5 provider is configured; set to off to retain semantic ranking without those filters.
# ROCKSERVER_SEMANTIC_LANGUAGE_FILTERS=off

# Optional non-secret overrides; defaults are yandexgpt and 3000 ms.
# YANDEX_LLM_MODEL=yandexgpt
# YANDEX_LLM_TIMEOUT_MS=3000

# Run the opt-in structured-command check with:
# cargo test --test yandex_llm_live -- --ignored --exact interprets_real_voice_command_with_safe_logs --nocapture
