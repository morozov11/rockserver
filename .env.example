# Safe local Compose example only. Replace every marker outside Git for a real deployment.
ROCKSERVER_IMAGE=rockserver:local
ROCKSERVER_CADDY_IMAGE=rockserver-caddy:local
ROCKSERVER_DOMAIN=api.rockserver.example.invalid
ROCKSERVER_BIND_ADDR=0.0.0.0:3000
ROCKSERVER_LOCAL_HTTP_PORT=80
POSTGRES_DB=rockserver
POSTGRES_USER=rockserver
POSTGRES_PASSWORD=__LOCAL_ONLY_NOT_A_SECRET__
DATABASE_URL=postgres://rockserver:__LOCAL_ONLY_NOT_A_SECRET__@postgres:5432/rockserver
ROCKSERVER_API_BEARER_TOKEN=__LOCAL_ONLY_BEARER_TOKEN_32_CHARACTERS__
ROCKSERVER_TRUSTED_PROXY_TOKEN=__LOCAL_ONLY_CADDY_PROXY_TOKEN_32_CHARACTERS__
# Used only by the explicit `cargo run --bin bootstrap_admin` operator command. Replace outside
# Git with protected deployment-secret values; the command never loads `.env` itself.
ROCKSERVER_ADMIN_BOOTSTRAP_USERNAME=__LOCAL_ONLY_ADMIN_USERNAME__
ROCKSERVER_ADMIN_BOOTSTRAP_PASSWORD=__LOCAL_ONLY_ADMIN_PASSWORD_MINIMUM_16_CHARACTERS__
RUST_LOG=info

# Optional local Yandex AI Studio intent parser. Leave secret values empty.
YANDEX_AI_API_KEY=
YANDEX_FOLDER_ID=

# Optional Yandex Smart Home read-only user integration. Register the exact
# callback https://rockplatform.win/api/v1/browser/yandex-home/callback in Yandex OAuth.
YANDEX_HOME_CLIENTID=
YANDEX_HOME_SECRET=

# Optional non-secret overrides; defaults are yandexgpt and 3000 ms.
# YANDEX_LLM_MODEL=yandexgpt
# YANDEX_LLM_TIMEOUT_MS=3000

# Run the opt-in structured-command check with:
# cargo test --test yandex_llm_live -- --ignored --exact interprets_real_voice_command_with_safe_logs --nocapture
